@page
@model IndexModel
@{
	ViewData["Title"] = "My Profile";
}

<div class="page-title">
	<div class="row align-items-center">
		<div class="col-sm-12">
			<h2 class="page-title-text d-inline-block">@ViewData["Title"]</h2>
			<div class="breadcrumbs d-inline-block">
				<ul>
					<li><a href="/">Dashboard</a></li>
					<li>@ViewData["Title"]</li>
				</ul>
			</div>
		</div>
	</div>
</div>
<div class="row">
	<form class="col-sm-6" id="profile-form" method="post">
		<div class="panel panel-default">
			<div class="panel-head">
				<div class="panel-title">Basic Info</div>
			</div>
			<div class="panel-body">
				<div asp-validation-summary="ModelOnly" class="text-danger" role="alert"></div>
				<partial name="_StatusMessage" for="StatusMessage" />
				
				<div class="form-group">
					<label>User Name <span class="form-required">*</span></label>
					<input type="text" class="form-control" asp-for="Username" placeholder="User Name" disabled readonly>
				</div>
				<div class="row content-input">
					<div class="col-sm-6">
						<div class="form-group">
							<label>First Name <span class="form-required">*</span></label>
							<input type="text" class="form-control" asp-for="Input.FirstName" placeholder="First Name" required>
							<span asp-validation-for="Input.FirstName" class="text-danger"></span>
						</div>
					</div>
					<div class="col-sm-6">
						<div class="form-group">
							<label>Last Name <span class="form-required">*</span></label>
							<input type="text" class="form-control" asp-for="Input.LastName" placeholder="Last Name" required>
							<span asp-validation-for="Input.LastName" class="text-danger"></span>
						</div>
					</div>
				</div>
				<div class="row content-input">
					<div class="col-sm-6">
						<div class="form-group">
							<label>Email <span class="form-required">*</span></label>
							<input type="text" class="form-control" asp-for="Username" placeholder="Email" disabled readonly>
						</div>
					</div>
					<div class="col-sm-6">
						<div class="form-group">
							<label>Mobile <span class="form-required">*</span></label>
							<input type="text" class="form-control" asp-for="Input.PhoneNumber" placeholder="Mobile">
							<span asp-validation-for="Input.PhoneNumber" class="text-danger"></span>
						</div>
					</div>
				</div>
			</div>
			<div class="panel-footer text-center">
				<button type="submit" id="update-profile-button" class="btn btn-primary"><i class="las la-save pr-2"></i> Save</button>
			</div>
		</div>
	</form>
</div>

@section Scripts {
	<partial name="_ValidationScriptsPartial" />
}
