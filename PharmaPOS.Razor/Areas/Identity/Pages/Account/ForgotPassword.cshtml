@page
@model ForgotPasswordModel
@{
    ViewData["Title"] = "Forgot Password";
}

<div class="lgn-form">
	
	<form method="post" class="form-vertical">
		<div asp-validation-summary="ModelOnly" class="text-danger" role="alert"></div>
		<div class="form-floating mb-3 lgn-input form-group">
			<label asp-for="Input.Email" class="form-label"></label>
			<input asp-for="Input.Email" class="form-control" autocomplete="username" aria-required="true" placeholder="name@example.com" />
			<span asp-validation-for="Input.Email" class="text-danger"></span>
		</div>
		<button type="submit" class="w-100 btn btn-lg btn-primary">Reset Now</button>
		
		<div class="text-center mt-4">
			<p class="mb-0 font-12">Rember Password?</p>
			<a asp-page="./Login" class="text-primary">Login Now</a>
		</div>
		
	</form>
	
</div>


@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
