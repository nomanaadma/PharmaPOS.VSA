@page "{id:int}"
@model PharmaPOS.Razor.Pages.Categories.EditModel
@{
	var pageTitle = "Edit Category";
	ViewData["Title"] = pageTitle;
}

<div class="page-title">
	<div class="row align-items-center">
		<div class="col-sm-12">
			<h2 class="page-title-text d-inline-block">@ViewData["Title"]</h2>
			<partial name="Partials/_Breadcrumb" model='new BreadcrumbItem[] { 
		         new("Medicine Categories", Url.Page("/Categories/Index")), 
		         new(pageTitle) 
	        }' />
		</div>
	</div>
</div>

<form method="post">
	@Html.AntiForgeryToken()
	<partial name="_CategoryForm" for="Input" />
</form>

@section Scripts {
	<partial name="_ValidationScriptsPartial" />
}
