@page "/Roles"
@using UserRole = PharmaPOS.Application.Common.Authorization.Roles;
@model PharmaPOS.Razor.Pages.Roles.IndexModel
@{
	const string pageTitle = "User Roles";
	ViewData["Title"] = pageTitle;
}

<div class="page-title">
	<div class="row align-items-center">
		<div class="col-sm-4">
			<h2 class="page-title-text d-inline-block">@ViewData["Title"]</h2>
			<partial name="Partials/_Breadcrumb" model="new BreadcrumbItem[] { 
				new(pageTitle) 
			}" />
		</div>
		<div class="col-sm-8 text-right">
			<a asp-page="/Roles/Add" class="btn btn-primary btn-sm">
				<i class="las la-plus pr-2"></i> New User Role
			</a>
		</div>
	</div>
</div>

<div class="panel panel-default">
	<div class="panel-body">
		<div class="table-responsive">
			<table class="table table-bordered table-striped datatable-table" width="100%">
				<thead>
					<tr class="table-heading">
						<th>#</th>
						<th>Role Name</th>
						<th>Description</th>
						<th>Created Date</th>
						<th></th>
					</tr>
				</thead>
				<tbody>
					@{ var index = 1; }
					@foreach (var value in Model.Roles)
					{
						<tr>
							<td>@index</td>
							<td class="text-primary">@value.Name</td>
							<td>@value.Description</td>
							<td>@value.CreatedDate</td>
							<td class="table-action">
								@if (value.Name != UserRole.Admin)
								{
									<a asp-page="/Roles/Edit" asp-route-id="@value.Id" class="text-primary edit" data-toggle="tooltip" title="Edit">
										<i class="las la-edit"></i>
									</a>
									<a class="table-delete text-danger delete" data-toggle="tooltip" title="Delete">
										<i class="las la-trash-alt"></i><input type="hidden" value="@value.Id">
									</a>
								}
							</td>
						</tr>
						index++;
					}
				</tbody>
			</table>
		</div>
	</div>
</div>

<partial name="Partials/_DeleteModal" model='@("/Roles/Index")' />
