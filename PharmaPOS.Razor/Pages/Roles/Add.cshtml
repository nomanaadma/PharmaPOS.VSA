@page "/Roles/Add"
@model PharmaPOS.Razor.Pages.Roles.AddModel
@{
	var pageTitle = "Add User Role";
	ViewData["Title"] = pageTitle;
}

<div class="page-title">
	<div class="row align-items-center">
		<div class="col-sm-12">
			<h2 class="page-title-text d-inline-block">@ViewData["Title"]</h2>
			<partial name="Partials/_Breadcrumb" model='new BreadcrumbItem[] { 
				new("User Roles", Url.Page("/Roles/Index")),
				new(pageTitle) 
			}' />
		</div>
	</div>
</div>

<form method="post">
	@Html.AntiForgeryToken()
	<partial name="_RoleForm" for="Input" />
</form>

@section Scripts {
	<partial name="_ValidationScriptsPartial" />
}
