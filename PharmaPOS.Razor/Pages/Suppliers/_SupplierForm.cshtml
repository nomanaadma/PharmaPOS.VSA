@model PharmaPOS.Razor.Models.SupplierViewModel

@if (Model.Id > 0)
{
	<input type="hidden" asp-for="Id" />
}
<div class="panel panel-default">
	<div class="panel-body">
		<div class="row">
			<div class="col-md-6">
				<div class="form-group">
					<label>Supplier Name <span class="form-required">*</span></label>
					<div class="input-group">
						<div class="input-group-prepend"><span class="input-group-text"><i class="las la-user"></i></span></div>
						<input type="text" asp-for="Name" class="form-control" placeholder="Enter Supplier Name . . ." required>
					</div>
					<span asp-validation-for="Name" class="text-danger"></span>
				</div>
				
				<div class="form-group">
					<label>Email Address <span class="form-required">*</span></label>
					<div class="input-group">
						<div class="input-group-prepend"><span class="input-group-text"><i class="las la-envelope"></i></span></div>
						<input type="email" asp-for="Email" class="form-control" placeholder="Enter Supplier Email Address . . ." required>
					</div>
					<span asp-validation-for="Email" class="text-danger"></span>
				</div>
			</div>

			<div class="col-md-6">
				<div class="form-group">
					<label>Phone Number <span class="form-required">*</span></label>
					<div class="input-group">
						<div class="input-group-prepend"><span class="input-group-text"><i class="las la-mobile"></i></span></div>
						<input type="text" asp-for="Phone" class="form-control" placeholder="Enter Supplier Phone Number . . ." required>
					</div>
					<span asp-validation-for="Phone" class="text-danger"></span>
				</div>

				<div class="form-group">
					<label>Address</label>
					<div class="input-group">
						<div class="input-group-prepend"><span class="input-group-text"><i class="las la-map-marker"></i></span></div>
						<textarea asp-for="Address" class="form-control" placeholder="Enter Address . . ."></textarea>
					</div>
					<span asp-validation-for="Address" class="text-danger"></span>
				</div>
			</div>
		</div>
	</div>
	<div class="panel-footer text-center">
		<button type="submit" class="btn btn-primary"><i class="las la-save pr-2"></i> Save</button>
		<a asp-page="/Suppliers/Index" class="btn btn-secondary"><i class="las la-times pr-2"></i> Cancel</a>
	</div>
</div>
