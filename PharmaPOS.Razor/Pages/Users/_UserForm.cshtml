@model PharmaPOS.Razor.Models.UserFormViewModel

<div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

<div class="panel panel-default">
	<div class="panel-body">
		<div class="tab-content pt-4">
			<div class="tab-pane active" id="user-info">
				<div class="row">
					<div class="col-lg-6">
						<div class="row">
							<div class="col-md-6">
								<div class="form-group">
									<label>First Name <span class="form-required">*</span></label>
									<div class="input-group">
										<div class="input-group-prepend">
											<span class="input-group-text"><i class="las la-user"></i></span>
										</div>
										<input type="text" asp-for="FirstName" class="form-control" placeholder="Enter First Name . . ." required>
									</div>
									<span asp-validation-for="FirstName" class="text-danger"></span>
								</div>
							</div>
							<div class="col-md-6">
								<div class="form-group">
									<label>Last Name <span class="form-required">*</span></label>
									<div class="input-group">
										<div class="input-group-prepend">
											<span class="input-group-text"><i class="las la-user"></i></span>
										</div>
										<input type="text" asp-for="LastName" class="form-control" placeholder="Enter Last Name . . ." required>
									</div>
									<span asp-validation-for="LastName" class="text-danger"></span>
								</div>
							</div>
						</div>
						<div class="form-group">
							<label>Mobile Number <span class="form-required">*</span></label>
							<div class="input-group">
								<div class="input-group-prepend">
									<span class="input-group-text"><i class="las la-mobile"></i></span>
								</div>
								<input type="text" asp-for="Mobile" class="form-control" placeholder="Enter Mobile Number . . ." required>
							</div>
							<span asp-validation-for="Mobile" class="text-danger"></span>
						</div>
					</div>
					<div class="col-lg-6">
						<div class="form-group">
							<label>Email Address <span class="form-required">*</span></label>
							<div class="input-group">
								<div class="input-group-prepend">
									<span class="input-group-text"><i class="las la-envelope"></i></span>
								</div>
								<input type="email" asp-for="Email" class="form-control" placeholder="Enter Email Address . . ." required>
							</div>
							<span asp-validation-for="Email" class="text-danger"></span>
						</div>
						<div class="row">
							<div class="col-lg-6">
								<div class="form-group">
									<label>Gender</label>
									<div class="input-group">
										<div class="input-group-prepend">
											<span class="input-group-text"><i class="las la-genderless"></i></span>
										</div>
										<select asp-for="Gender" asp-items="Html.GetEnumSelectList<Gender>()" class="custom-select">
										</select>
									</div>
								</div>
							</div>
							@if (!string.IsNullOrEmpty(Model.UserId))
							{
								<div class="col-lg-6">
									<div class="form-group">
										<label>Status</label>
										<div class="input-group">
											<div class="input-group-prepend">
												<span class="input-group-text"><i class="las la-check-square"></i></span>
											</div>
											<select asp-for="Status" class="custom-select">
												<option value="1">Enabled</option>
												<option value="0">Disabled</option>
											</select>
										</div>
									</div>
								</div>
							}
						</div>
					</div>
				</div>
				<div class="dotted-seprator mt-4 mb-5"></div>
				<div class="row">
					<div class="col-md-6">
						<div class="form-group">
							<label>User Role <span class="form-required">*</span></label>
							<div class="input-group">
								<div class="input-group-prepend"><span class="input-group-text"><i class="las la-user-tag"></i></span></div>
								<select asp-for="UserRole" asp-items="Model.Roles" class="custom-select" required>
									<option value="">Select Role</option>
								</select>
							</div>
							<span asp-validation-for="UserRole" class="text-danger"></span>
						</div>
					</div>
					<div class="col-md-6">
						<div class="form-group">
							<label>User Name <span class="form-required">*</span></label>
							<div class="input-group">
								<div class="input-group-prepend">
									<span class="input-group-text"><i class="las la-address-card"></i></span>
								</div>
								<input type="text" asp-for="UserName" class="form-control" placeholder="Enter User Name . . ." required>
							</div>
							<span asp-validation-for="UserName" class="text-danger"></span>
						</div>
					</div>
					@if (string.IsNullOrEmpty(Model.UserId))
					{
						<div class="col-md-6">
							<div class="form-group">
								<label>Password <span class="form-required">*</span></label>
								<div class="input-group">
									<div class="input-group-prepend"><span class="input-group-text"><i class="las la-key"></i></span></div>
									<input type="password" asp-for="Password" class="form-control" placeholder="Enter Password . . ." required>
								</div>
								<span asp-validation-for="Password" class="text-danger"></span>
							</div>
						</div>
						<div class="col-md-6">
							<div class="form-group">
								<label>Confirm Password <span class="form-required">*</span></label>
								<div class="input-group">
									<div class="input-group-prepend"><span class="input-group-text"><i class="las la-key"></i></span></div>
									<input type="password" asp-for="ConfirmPassword" class="form-control" placeholder="Enter Password . . ." required>
								</div>
								<span asp-validation-for="ConfirmPassword" class="text-danger"></span>
							</div>
						</div>
					}
				</div>
			</div>
		</div>
	</div>
	@if (!string.IsNullOrEmpty(Model.UserId))
	{
		<input type="hidden" asp-for="UserId" />
	}
	<div class="panel-footer text-center">
		<button type="submit" class="btn btn-primary"><i class="las la-save pr-2"></i> Save</button>
		<a asp-page="/Users/Index" class="btn btn-secondary"><i class="las la-times pr-2"></i> Cancel</a>
	</div>
</div>
