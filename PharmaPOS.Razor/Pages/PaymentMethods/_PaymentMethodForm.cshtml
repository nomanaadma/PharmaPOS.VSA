@model PharmaPOS.Razor.Models.PaymentMethodViewModel

@if (Model.Id > 0)
{
	<input type="hidden" asp-for="Id" />
}
<div class="panel panel-default">
	<div class="panel-body">
		<div class="row">
			<div class="col-md-6">
				<div class="form-group">
					<label class="col-form-label">Payment Method Name <span class="form-required">*</span></label>
					<input type="text" asp-for="Name" class="form-control" placeholder="Enter Payment Method Name . . ." required>
					<span asp-validation-for="Name" class="text-danger"></span>
				</div>
			</div>
			<div class="col-md-6">
				<div class="form-group">
					<label class="col-form-label">Status</label>
					<select asp-for="Status" class="custom-select" asp-items="Html.GetEnumSelectList<Status>()">
					</select>
					<span asp-validation-for="Status" class="text-danger"></span>
				</div>
			</div>
		</div>
	</div>
	<div class="panel-footer text-center">
		<button type="submit" class="btn btn-primary"><i class="las la-save pr-2"></i> Save</button>
		<a asp-page="/PaymentMethods/Index" class="btn btn-secondary"><i class="las la-times pr-2"></i> Cancel</a>
	</div>
</div>
