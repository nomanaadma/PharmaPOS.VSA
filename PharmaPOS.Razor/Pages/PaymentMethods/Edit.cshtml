@page "{id:int}"
@model PharmaPOS.Razor.Pages.PaymentMethods.EditModel
@{
	var pageTitle = "Edit Payment Method";
	ViewData["Title"] = pageTitle;
}

<div class="page-title">
	<div class="row align-items-center">
		<div class="col-sm-12">
			<h2 class="page-title-text d-inline-block">@ViewData["Title"]</h2>
			<partial name="Partials/_Breadcrumb" model='new BreadcrumbItem[] { 
				new("Payment Methods", Url.Page("/PaymentMethods/Index")),
				new(pageTitle) 
			}' />
		</div>
	</div>
</div>

<form method="post">
	@Html.AntiForgeryToken()
	<partial name="_PaymentMethodForm" for="Input" />
</form>

@section Scripts {
	<partial name="_ValidationScriptsPartial" />
}
